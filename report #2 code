// 첫번째 운명의 숫자 프로그램 실행
#include <stdio.h>

int main(void) {
    int birthdate; // 생년월일을 저장할 변수
    int sum = 0;   // 각 자리 숫자의 합을 저장할 변수

    // 1. 생년월일 입력받기
    printf("Enter your 8-digit birthdate (YYYYMMDD): ");
    scanf_s("%d", &birthdate); // 보안이 강화된 scanf_s 사용

    // [예외처리] 음수나 0이 입력된 경우 방어 로직
    if (birthdate <= 0) {
        printf("잘못된 입력입니다. 양수의 8자리 숫자를 입력해주세요.\n");
        return 1; // 비정상 종료
    }

    printf("Calculating...\n");

    // 2. 운명의 숫자 계산 (1자리가 될 때까지 반복)
    while (birthdate >= 10) { // 10 이상이면 2자리 수 이상이므로 루프 실행
        sum = 0; // 새로운 합산을 위해 sum 초기화

        // 각 자리 숫자를 떼어내어 더하는 내부 루프
        while (birthdate > 0) {
            sum += birthdate % 10; // 마지막 자리 숫자를 sum에 누적
            birthdate /= 10;       // 마지막 자리를 제거하여 자릿수 축소
        }

        birthdate = sum; // 모두 더한 값을 다시 변수에 대입하여 검사 준비
        printf("Sum of digits: %d\n", birthdate);
    }

    printf("Your Destiny Number is %d!\n", birthdate);

    // 3. switch문을 이용한 운세 메시지 분기 출력
    switch (birthdate) {
    case 1: printf("[Destiny Message]\nYou are a natural leader!\n"); break;
    case 2: printf("[Destiny Message]\nYou are a peacemaker!\n"); break;
    case 3: printf("[Destiny Message]\nYou are creative and optimistic!\n"); break;
    case 4: printf("[Destiny Message]\nYou are hardworking and grounded!\n"); break;
    case 5: printf("[Destiny Message]\nYou are adventurous and free-spirited!\n"); break;
    case 6: printf("[Destiny Message]\nYou are responsible and caring!\n"); break;
    case 7: printf("[Destiny Message]\nYou are an analytical thinker and a seeker of truth!\n"); break;
    case 8: printf("[Destiny Message]\nYou are ambitious and successful!\n"); break;
    case 9: printf("[Destiny Message]\nYou are compassionate and a humanitarian!\n"); break;
    default: printf("[Destiny Message]\nUnknown destiny.\n"); break; // 1~9 이외의 예외 상황
    }

    return 0; 
}

// 두번째 블랙홀의 중력장 탈출
#include <stdio.h>

int main(void) 
{
    int energy;           // 엔진 에너지를 저장할 변수
    int steps = 0;        // 1이 될 때까지 걸린 총 단계를 저장할 변수
    int max_altitude = 0; // 과정 중 도달한 최고 에너지를 저장할 변수

    // 1. 초기 에너지 입력
    printf("Enter the initial engine energy: ");
    scanf_s("%d", &energy); // 안전한 입력 함수 사용

    // [예외처리] 양의 정수가 아닌 값(음수, 0) 방어 로직
    if (energy <= 0) {
        printf("에너지는 양의 정수여야 합니다.\n");
        return 1;
    }

    max_altitude = energy; // 초기값을 현재 최고 고도로 우선 설정
    printf("Sequence: ");

    // 2. 에너지가 1이 될 때까지 시퀀스 반복
    while (energy != 1) {
        printf("%d -> ", energy);

        // 짝수와 홀수에 따른 엔진 에너지 패턴 변화 로직
        if (energy % 2 == 0) {
            energy = energy / 2;       // 짝수일 경우 반으로 감소
        }
        else {
            energy = (energy * 3) + 1; // 홀수일 경우 3배 후 1 증가
        }

        steps++; // 1회 수행할 때마다 단계 수 1 증가

        // [수식 처리] 최고 에너지(고도) 수치 갱신
        if (energy > max_altitude) {
            max_altitude = energy;
        }
    }

    // 반복문을 빠져나온 후 마지막 도달 수치 1 출력
    printf("1\n");

    // 3. 최종 결과 출력
    printf("Escape successful!\n");
    printf("Total steps: %d\n", steps);
    printf("Maximum altitude reached: %d\n", max_altitude);

    return 0;
}


// 세번째 특이한 자판기
#include <stdio.h>

#define RED_POTION 1000
#define MAGIC_SCROLL 2000
#define ELIXIR 3000

int main(void) {
    int balance, choice, count = 0, price = 0;
    const char* item_name = ""; // 선택한 아이템 이름을 임시 저장할 문자열 변수

    printf("Insert coins (Current Balance): ");
    scanf_s("%d", &balance);

    // [예외처리] 투입 금액이 음수인 경우 방어
    if (balance < 0) {
        printf("Please insert a valid amount.\n");
        return 1;
    }

    while (1) {
        // 메뉴 출력문을 하나로 통합하여 길이 단축
        printf("\nGoblin's Vending Machine\n1. Red Potion (%d G)\n2. Magic Scroll (%d G)\n3. Elixir (%d G)\n0. Exit\nSelect an item: ", RED_POTION, MAGIC_SCROLL, ELIXIR);
        scanf_s("%d", &choice);

        if (choice == 0) {
            printf("Returning %d G. Goodbye!\n", balance);
            break;
        }

        // if~else 대신 switch문을 사용하여 가격과 아이템 이름을 한 번에 매핑
        switch (choice) {
        case 1: price = RED_POTION; item_name = "Red Potion"; break;
        case 2: price = MAGIC_SCROLL; item_name = "Magic Scroll"; break;
        case 3: price = ELIXIR; item_name = "Elixir"; break;
        default: printf("Please select a valid menu number.\n"); continue;
        }

        // count를 먼저 1 증가시킨 후 3의 배수인지 판별 (로직 1줄 압축)
        if (++count % 3 == 0) {
            printf("*** GOBLIN'S BLESSING! 50%% DISCOUNT! ***\n");
            price /= 2;
        }

        // 출력 로직을 통합하여 item_name 변수로 한 번에 처리
        if (balance >= price) {
            balance -= price;
            printf("[Purchased] %s for %d G. Balance: %d G\n", item_name, price, balance);
        }
        else {
            printf("Not enough balance!\n");
            count--;
        }
    }
    return 0;
}
